{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"zhizhi\u00b7lovethislife","text":""},{"location":"course/","title":"\u7b14\u8bb0","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u7684\u5b66\u4e60\u7b14\u8bb0\u3001\u5fc3\u5f97\u4f53\u4f1a\u548c\u77e5\u8bc6\u6574\u7406\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u6587\u6863</li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863","text":"<p>\u672c\u6587\u6863\u5c55\u793a\u4e00\u7bc7\u6587\u7ae0\u7684\u63a8\u8350\u683c\u5f0f\uff0c\u4ee5\u540e\u4f60\u53ef\u4ee5\u53c2\u8003\u8fd9\u4e2a\u6a21\u677f\u6765\u5199\u7b14\u8bb0\u3002</p>"},{"location":"course/example/#_2","title":"\u4e00\u3001\u6807\u9898","text":"<p>\u4f7f\u7528 <code>##</code> \u8868\u793a\u4e8c\u7ea7\u6807\u9898\uff0c<code>###</code> \u8868\u793a\u4e09\u7ea7\u6807\u9898\uff0c\u4ee5\u6b64\u7c7b\u63a8\u3002<code>#</code> \u662f\u4e00\u7ea7\u6807\u9898\uff0c\u4e00\u822c\u6bcf\u7bc7\u6587\u6863\u53ea\u7528\u4e00\u6b21\uff08\u6700\u4e0a\u9762\u90a3\u4e2a\uff09\u3002</p>"},{"location":"course/example/#_3","title":"\u4e8c\u3001\u6b63\u6587","text":"<p>\u6b63\u6587\u76f4\u63a5\u5199\u5c31\u597d\uff0c\u6bcf\u5199\u5b8c\u4e00\u6bb5\u5c31\u7a7a\u4e00\u884c\uff08\u6309\u4e00\u4e0b\u56de\u8f66\u6362\u884c\uff09\u3002</p> <p>\u8fd9\u662f\u52a0\u7c97\u7684\u6587\u5b57\uff0c\u8fd9\u662f\u659c\u4f53\u7684\u6587\u5b57\u3002</p>"},{"location":"course/example/#_4","title":"\u4e09\u3001\u5217\u8868","text":"<p>\u65e0\u5e8f\u5217\u8868\u7528 <code>-</code> \u5f00\u5934\uff1a</p> <ul> <li>\u7b2c\u4e00\u9879</li> <li>\u7b2c\u4e8c\u9879</li> <li>\u5d4c\u5957\u9879\u76ee\uff08\u524d\u9762\u591a\u51e0\u4e2a\u7a7a\u683c\uff09</li> <li>\u7b2c\u4e09\u9879</li> </ul> <p>\u6709\u5e8f\u5217\u8868\u7528\u6570\u5b57\u5f00\u5934\uff1a</p> <ol> <li>\u7b2c\u4e00\u6b65</li> <li>\u7b2c\u4e8c\u6b65</li> <li>\u7b2c\u4e09\u6b65</li> </ol>"},{"location":"course/example/#_5","title":"\u56db\u3001\u4ee3\u7801","text":"<p>\u884c\u5185\u4ee3\u7801\u7528\u53cd\u5f15\u53f7\u5305\u88f9\uff0c\u6bd4\u5982 <code>print(\"hello\")</code>\u3002</p> <p>\u4ee3\u7801\u5757\u7528\u4e09\u4e2a\u53cd\u5f15\u53f7\u5305\u88f9\uff0c\u5e76\u5199\u4e0a\u8bed\u8a00\u540d\uff1a</p> <pre><code>def hello():\n    print(\"Hello, world!\")\n</code></pre> <pre><code>echo \"\u8fd9\u662f\u4e00\u4e2a\u547d\u4ee4\u884c\"\n</code></pre>"},{"location":"course/example/#_6","title":"\u4e94\u3001\u5f15\u7528","text":"<p>\u7528 <code>&gt;</code> \u5f00\u5934\u8868\u793a\u5f15\u7528\u3002</p> <p>\u591a\u884c\u5f15\u7528\u53ef\u4ee5\u5728\u6bcf\u884c\u524d\u52a0 <code>&gt;</code>\u3002</p>"},{"location":"course/example/#_7","title":"\u516d\u3001\u94fe\u63a5\u4e0e\u56fe\u7247","text":"<ul> <li>\u5916\u90e8\u94fe\u63a5\uff1a<code>[\u94fe\u63a5\u6587\u5b57](https://example.com)</code></li> <li>\u5185\u90e8\u94fe\u63a5\uff1a<code>[\u8df3\u8f6c\u5230\u7b14\u8bb0\u9996\u9875](index.md)</code></li> <li>\u56fe\u7247\uff1a<code>![\u56fe\u7247\u8bf4\u660e](\u56fe\u7247\u5730\u5740)</code></li> </ul>"},{"location":"course/example/#_8","title":"\u4e03\u3001\u5206\u5272\u7ebf","text":"<p>\u4e09\u4e2a\u6216\u66f4\u591a\u77ed\u6a2a\u7ebf\uff1a</p>"},{"location":"course/example/#_9","title":"\u516b\u3001\u8868\u683c","text":"\u52171 \u52172 \u52173 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 \u5185\u5bb9 <p>\u8fd9\u5c31\u662f\u4e00\u7bc7\u6807\u51c6\u7b14\u8bb0\u7684\u57fa\u672c\u683c\u5f0f\u4e86\u3002\u4f60\u53ea\u9700\u8981\u6253\u5f00\u4e00\u4e2a\u65b0 <code>.md</code> \u6587\u4ef6\uff0c\u7167\u8fd9\u4e2a\u683c\u5f0f\u5199\u5c31\u884c\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u4ee5\u4e0b\u662f\u4e00\u4e9b\u670b\u53cb\u7684\u7f51\u7ad9\uff0c\u6b22\u8fce\u4e32\u95e8~</p> <ul> <li>Example \u7684\u535a\u5ba2 \u2014 \u4e00\u4e2a\u5f88\u68d2\u7684\u6280\u672f\u535a\u5ba2</li> <li>GitHub \u2014 \u5168\u7403\u6700\u5927\u7684\u4ee3\u7801\u6258\u7ba1\u5e73\u53f0</li> </ul> <p>\u5982\u679c\u4f60\u4e5f\u6709\u4e2a\u4eba\u7f51\u7ad9\uff0c\u6b22\u8fce\u6765\u4ea4\u6362\u53cb\u94fe\uff01</p>"},{"location":"life/","title":"\u751f\u6d3b","text":"<p>\u6b22\u8fce\u6765\u5230\u6211\u7684\u5c0f\u4e16\u754c\u3002</p> <p>\u8fd9\u91cc\u4f1a\u8bb0\u5f55\u4e00\u4e9b\u65e5\u5e38\u788e\u788e\u5ff5\u3001\u65c5\u884c\u7684\u7167\u7247\u3001\u770b\u8fc7\u7684\u4e66\u548c\u7535\u5f71\uff0c\u8fd8\u6709\u751f\u6d3b\u4e2d\u7684\u5404\u79cd\u6709\u8da3\u77ac\u95f4\u3002</p> <p>\u6162\u6162\u66f4\u65b0\u4e2d...</p>"}]}